# Offline commands (plan, analyze, serve, tests) need no credentials.
# Judge runs make paid API calls and only happen when you pass --live.
GEMINI_API_KEY=
TYPESAFE_API_KEY=

GEMINI_JUDGE_MODEL=gemini-3.8-flash
# Record the version Jev reports (for example jev-1.13.0) when publishing results.
JEV_MODEL=jev-latest

# Gemini judge temperature. Jev has no temperature setting.
JUDGE_TEMPERATURE=0
# Per-request timeout in seconds, retries on HTTP 429/5xx, and parallel requests.
REQUEST_TIMEOUT_S=60
MAX_RETRIES=2
MAX_WORKERS=4

# Optional current USD prices per million tokens, used only for cost in the report.
GEMINI_JUDGE_INPUT_USD_PER_MILLION=
GEMINI_JUDGE_OUTPUT_USD_PER_MILLION=
JEV_INPUT_USD_PER_MILLION=
JEV_OUTPUT_USD_PER_MILLION=
