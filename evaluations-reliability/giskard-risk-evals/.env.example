# Replaying the recorded runs, the tests and `record` without --live need no credentials.
# Live runs make paid Gemini calls: one agent call per turn, one attacker call per turn and one judge call per attack.
GEMINI_API_KEY=

# Model for the agent under test.
GEMINI_MODEL=gemini-3.8-flash
# Models Giskard uses to play the attacker and to judge. Both default to GEMINI_MODEL.
ATTACKER_MODEL=
JUDGE_MODEL=

# Attacks per live run (capped at 10), parallel attacks, and a time limit per attack in seconds.
ATTACKS_PER_RUN=10
MAX_CONCURRENCY=5
ATTACK_TIMEOUT_S=180

# Giskard's optional usage analytics never include prompts or outputs; this switches them off entirely.
DO_NOT_TRACK=1
