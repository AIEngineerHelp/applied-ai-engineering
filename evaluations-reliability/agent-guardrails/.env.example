# Offline commands (plan, rules-only evaluation, scripted agent runs, analyze, tests) need no credentials.
# Classifier and agent runs make paid API calls and only happen when you pass --live.
GEMINI_API_KEY=
TYPESAFE_API_KEY=

# Gemini model for the LLM classifier and for the live agent.
GEMINI_MODEL=gemini-3.8-flash
# Record the version Jev reports (for example jev-1.13.0) when publishing results.
JEV_MODEL=jev-latest

# Per-request timeout in seconds, retries on HTTP 429/5xx, and parallel classifier requests.
REQUEST_TIMEOUT_S=60
MAX_RETRIES=2
MAX_WORKERS=4

# Optional current USD prices per million tokens, used only for cost in the report.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
JEV_INPUT_USD_PER_MILLION=
