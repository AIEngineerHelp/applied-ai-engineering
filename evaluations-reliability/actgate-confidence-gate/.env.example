# ActGate — copy to .env and fill in values
# NEVER commit real keys

DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/actgate

TYPESAFE_API_KEY=
GEMINI_API_KEY=

# Laya: local System One (set false to skip if GPU/model unavailable)
LAYA_ENABLED=true
LAYA_PRELOAD=true
LAYA_MODEL=convaiinnovations/laya
LAYA_DEVICE=cpu

# Gate policy
CONFIDENCE_AUTO=0.82
CONFIDENCE_JEV=0.55
URGENCY_HIGH=0.75
RISK_BLOCK=high

# Gemini
GEMINI_MODEL=gemini-3.8-flash

# App
APP_HOST=127.0.0.1
APP_PORT=8787
LOG_LEVEL=info

# true only on the public LinkedIn demo
DEMO_MODE=false
