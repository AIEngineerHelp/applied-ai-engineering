# Copy to .env. Nothing here is needed for `simulate` (offline) or the tests.

# Gemini API key: the realtime model, the cascade LLM and TTS, and post-call summaries.
# Every voice call and `simulate --live` makes paid requests with it.
GEMINI_API_KEY=

# LiveKit. The defaults match `docker compose up -d` (a local dev server).
# For the cascade pipeline (its STT runs on LiveKit Inference) or SIP phone calls,
# use a LiveKit Cloud project: wss://<project>.livekit.cloud and its key and secret.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# realtime | cascade (the dashboard can override per call)
VOICE_PIPELINE=realtime
REALTIME_MODEL=gemini-3.8-live
REALTIME_VOICE=Puck
CASCADE_STT=deepgram/nova-3
CASCADE_LLM=gemini-3.8-flash
CASCADE_TTS=gemini-3.1-flash-tts-preview
CASCADE_TTS_VOICE=Kore
EXTRACTION_MODEL=gemini-3.8-flash

# The mock CRM and demo webhook receiver are served by `python -m voiceagent serve`.
CRM_URL=http://127.0.0.1:4331/crm
CRM_API_KEY=dev-crm-key
WEBHOOK_URL=http://127.0.0.1:4331/api/webhooks/receiver
WEBHOOK_SECRET=dev-webhook-secret
