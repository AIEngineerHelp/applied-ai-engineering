# Offline mode works without credentials. Keys never go to the browser.
GEMINI_API_KEY=
TYPESAFE_API_KEY=
# Set both to model versions available to your accounts before enabling live runs.
GEMINI_MODEL=gemini-3.8-flash
TYPESAFE_MODEL=jev-latest
# Live requests incur provider charges; enable deliberately.
ENABLE_LIVE=false
PORT=4317
# For a public deployment, listen on all interfaces and list every accepted hostname.
HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional current USD prices per million tokens. Leave blank if unknown.
# Output rates should include the provider's treatment of reasoning tokens.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
TYPESAFE_INPUT_USD_PER_MILLION=
TYPESAFE_OUTPUT_USD_PER_MILLION=

# Optional: your chosen USD-to-INR rate, only for displaying API cost estimates.
USD_TO_INR=

# Vercel only: connect a PRIVATE Blob store for persistent run history.
# Prefer the project-connected BLOB_STORE_ID; the SDK also supports a server-only token.
# BLOB_STORE_ID=store_example
# BLOB_READ_WRITE_TOKEN=replace_with_private_blob_token

# Vercel live access: set a shared password, OR explicitly enable public use.
# LIVE_ACCESS_PASSWORD=replace_with_a_strong_shared_password
# PUBLIC_LIVE=true
