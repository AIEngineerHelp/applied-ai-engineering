# Copy to .env and adjust. Used by the app when run on the host (`uv run ...`) and by
# docker compose (variable interpolation + env_file). docker-compose.yml overrides the
# host names below (postgres, redis, litellm, neo4j) for the containers.
# Contract: docs/production-contract.md. Deployment: docs/deployment.md.

# ---------------------------------------------------------------- runtime mode
# `prod` enables strict startup validation (OIDC, all infra enabled, non-default secrets).
ENVIRONMENT=dev
LOG_LEVEL=INFO
# `json` for structured logs (compose defaults the containers to json)
LOG_FORMAT=text

# ---------------------------------------------------------------- PostgreSQL + pgvector
POSTGRES_USER=ira
POSTGRES_PASSWORD=ira_password
POSTGRES_DB=ira_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# disable | prefer | require | verify-ca | verify-full (+ POSTGRES_SSLROOTCERT=/path/ca.pem)
POSTGRES_SSLMODE=prefer

# ---------------------------------------------------------------- Redis
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Neo4j (optional, compose profile `kg`)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ira_password

# ---------------------------------------------------------------- LiteLLM
LITELLM_API_BASE=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-master-key

# Gemini: when set, gemini/* models are called directly; otherwise via the LiteLLM proxy.
# In docker compose the app containers always use the proxy; this key is given to LiteLLM only.
GEMINI_API_KEY=
# Used by the LiteLLM proxy for text-embedding-3-small and the cross-provider fallback.
OPENAI_API_KEY=

# ---------------------------------------------------------------- infrastructure toggles
# All off = runs without docker-compose (caches/queue/memory skipped).
# docker compose forces REDIS/POSTGRES/QUEUE on. All three must be true in prod.
REDIS_ENABLED=false
POSTGRES_ENABLED=false
NEO4J_ENABLED=true
QUEUE_ENABLED=false

# Must match the embedding model's output size (text-embedding-3-small = 1536)
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIM=1536

# ---------------------------------------------------------------- orchestration limits
MAX_ITERATIONS=3
MIN_CONFIDENCE=0.6
MAX_BUDGET_USD=2.0
APPROVAL_TIMEOUT_S=3600

# ---------------------------------------------------------------- auth (OIDC)
# `disabled` is refused when ENVIRONMENT=prod.
AUTH_MODE=disabled
# e.g. https://login.example.com/realms/ira
OIDC_ISSUER=
# Expected `aud` claim of API access tokens
OIDC_AUDIENCE=
# Public (PKCE, no secret) client id used by the UI
OIDC_CLIENT_ID=
OIDC_SCOPES=openid profile email
OIDC_ROLES_CLAIM=groups
# JSON: IdP group -> role (viewer|responder|approver|admin)
OIDC_ROLE_MAPPING={}
# JSON list of static bearer tokens for alert webhooks (only POST /v1/incidents).
# In prod each token must be >= 32 chars, e.g. `openssl rand -hex 32`.
INTAKE_TOKENS=[]

# ---------------------------------------------------------------- API / HTTP
# JSON list; in prod it must be explicit (no "*")
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ---------------------------------------------------------------- storage
# Writable directory for scrubbed tool outputs (containers: /var/lib/ira/artifacts)
ARTIFACTS_DIR=data/artifacts

# ---------------------------------------------------------------- tracing
# When set, traces are exported via OTLP/HTTP. With `--profile observability` in compose:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------- frontend (build time)
# API base URL baked into the UI bundle. Empty = same origin (behind the Helm ingress).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------- compose-only
# Grafana admin (compose `observability` profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Image names/tags used by `docker compose build` (and to run released images)
# IRA_IMAGE=ghcr.io/<org>/incident-response-agent
# IRA_FRONTEND_IMAGE=ghcr.io/<org>/incident-response-agent-frontend
# IRA_TAG=local
# LITELLM_IMAGE=ghcr.io/berriai/litellm:main-stable
