      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(ira_hitl_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ira_hitl_wait_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Time actions wait for a human approval decision."
    },
    {
      "id": 10,
      "title": "LLM cost by model (USD per hour)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
