{
  "name": "pharma-research-agent",
  "version": "1.0.0",
  "private": true,
  "description": "A research workspace for pharmaceutical and clinical evidence: an orchestrator, parallel research sub-agents over PubMed, ClinicalTrials.gov, openFDA and the web, a virtual file system, a synthesis agent, and evals and traces",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev --port 4325",
    "build": "next build",
    "start": "next start --port 4325",
    "lint": "eslint",
    "check": "tsc --noEmit",
    "test": "node --import=tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx scripts/migrate.ts",
    "research": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --import=tsx scripts/research.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@neondatabase/serverless": "^1.2.0",
    "@react-pdf/renderer": "^4.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "docx": "^9.10.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.56.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "workflow": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
