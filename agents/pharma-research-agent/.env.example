# Gemini (live runs). Without a key the app replays saved runs and `npm run research` is an offline dry run.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Prices for cost estimates, USD. Checked 2026-10-12 at https://ai.google.dev/gemini-api/docs/pricing:
# gemini-3.8-flash $0.75 input / $3.75 output (incl. thinking) per 1M tokens.
# Grounded search: the first 5,000 queries a month are free on Gemini 3+, then $14 per 1,000 (0.014 each).
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
GEMINI_SEARCH_USD_PER_QUERY=0

# Optional, for the public APIs (all work without keys).
# NCBI: 3 requests/s without a key, 10 with one. Contact email is recommended.
NCBI_API_KEY=
NCBI_EMAIL=
# openFDA: 1,000 requests/day per IP without a key.
OPENFDA_API_KEY=
