# ── Model ──────────────────────────────────────────────────────────────
# Required in production. Without it, local development uses the offline
# stand-in (scripted model, recorded sources) so the app still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# How much the model thinks: low, medium or high (default). Setting a level is
# also what makes Gemini return the thought summaries the UI streams.
GEMINI_THINKING_LEVEL=high
# Model for the guardrails (screening questions, checking reports). Defaults to
# GEMINI_MODEL; it always runs at a low thinking level, for speed.
GEMINI_GUARD_MODEL=
# Prices for cost reporting, USD. Checked 2026-10-12 at https://ai.google.dev/gemini-api/docs/pricing:
# gemini-3.8-flash $0.75 input / $3.75 output (incl. thinking) per 1M tokens.
# Grounded search: first 5,000 queries a month free on Gemini 3+, then $14 per 1,000 (0.014 each).
GEMINI_INPUT_USD_PER_MILLION=0.75
GEMINI_OUTPUT_USD_PER_MILLION=3.75
GEMINI_SEARCH_USD_PER_QUERY=0

# ── Database ───────────────────────────────────────────────────────────
# Postgres (Neon on Vercel). Leave empty locally to use embedded PGlite in .data/pglite.
DATABASE_URL=

# ── Operator controls ──────────────────────────────────────────────────
# Set to "false" to pause new research (existing reports stay readable).
RESEARCH_ENABLED=true
# Optional global cap on research runs per UTC day (0 or empty = no cap).
DAILY_RUN_CAP=

# ── Local development only ─────────────────────────────────────────────
# Force the offline stand-in even with a key, and simulate model latency (ms).
RESEARCH_OFFLINE=
RESEARCH_OFFLINE_DELAY_MS=

# ── Public APIs (all optional; they work without keys) ─────────────────
# NCBI: 3 requests/s without a key, 10 with one; a contact email is recommended.
NCBI_API_KEY=
NCBI_EMAIL=
# openFDA: 1,000 requests/day per IP without a key.
OPENFDA_API_KEY=

# ── Tracing (optional) ─────────────────────────────────────────────────
# LangSmith traces every LangGraph node and LangChain model call when these are
# set; no code changes are needed. Questions are redacted for personal data
# before any model call, so traces never hold what the guard removed.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=pharma-research-agent
# On serverless (Vercel), send traces before the function ends:
# LANGCHAIN_CALLBACKS_BACKGROUND=false
