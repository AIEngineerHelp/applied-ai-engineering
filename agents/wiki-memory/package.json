{
  "name": "wiki-memory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wiki memory for agents: an LLM-maintained markdown wiki, ingested one source at a time",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "data": "node --import=tsx scripts/build-data.ts",
    "build:client": "esbuild client/app.ts --bundle --format=esm --outdir=site/build --entry-names=[name] && tailwindcss -i client/styles.css -o site/build/app.css --minify",
    "build": "npm run check && npm run build:client",
    "start": "npm run build:client && node --import=tsx scripts/serve.ts",
    "check": "tsc --noEmit",
    "test": "node --import=tsx --test tests/*.test.ts",
    "export": "npm run build:client && node --import=tsx scripts/export.ts"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
