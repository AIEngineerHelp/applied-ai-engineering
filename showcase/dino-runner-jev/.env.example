# The game, human mode, and rule bot work without credentials.
# The key stays on the server and never reaches the browser.
TYPESAFE_API_KEY=
# Pin a version (for example jev-1.13.0) when publishing benchmark results.
TYPESAFE_MODEL=jev-latest
# Live requests incur provider charges; enable deliberately.
ENABLE_LIVE=false
# Per-request timeout in milliseconds (500-30000). No automatic retries.
TYPESAFE_TIMEOUT_MS=5000
PORT=4318
HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional current USD prices per million tokens. Leave blank if unknown.
TYPESAFE_INPUT_USD_PER_MILLION=
TYPESAFE_OUTPUT_USD_PER_MILLION=
# Spending limits per server instance (defaults shown).
# MAX_JEV_IN_FLIGHT=16
# MAX_JEV_CALLS_PER_MINUTE=300
# MAX_JEV_CALLS_PER_DAY=5000
# MAX_JEV_IN_FLIGHT_PER_CLIENT=3
# MAX_JEV_CALLS_PER_MINUTE_PER_CLIENT=150

# Vercel only: choose who may use live Jev calls. Without one of these, a
# deployment with ENABLE_LIVE=true refuses to serve.
# PUBLIC_LIVE=true
# LIVE_ACCESS_PASSWORD=replace_with_a_strong_shared_password
