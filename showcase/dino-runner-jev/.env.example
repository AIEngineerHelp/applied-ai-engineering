# The game, human mode, and rule bot work without credentials.
# The key stays on the server and never reaches the browser.
TYPESAFE_API_KEY=
# Pin a version (for example jev-1.13.0) when publishing benchmark results.
TYPESAFE_MODEL=jev-latest
# Live requests incur provider charges; enable deliberately.
ENABLE_LIVE=false
# Per-request timeout in milliseconds (500-30000). No automatic retries.
TYPESAFE_TIMEOUT_MS=5000
PORT=4318
HOST=127.0.0.1
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional current USD prices per million tokens. Leave blank if unknown.
TYPESAFE_INPUT_USD_PER_MILLION=
TYPESAFE_OUTPUT_USD_PER_MILLION=
