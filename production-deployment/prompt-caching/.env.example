# Copy to .env and add your key. Only the live experiment needs it;
# the playground, tests and dry runs work without one.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Requests per layout (2-12), pause between requests, and output cap.
REQUESTS_PER_LAYOUT=12
PAUSE_MS=1500
MAX_OUTPUT_TOKENS=300
REQUEST_TIMEOUT_MS=60000
MAX_RETRIES=2
