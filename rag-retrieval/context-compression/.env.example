# Optional hosted compression. The server never sends a request until the user
# explicitly clicks Run compression and checks paid-call consent in the app.
COMPRESR_API_KEY=cmp_placeholder

# Keep disabled until the laptop owner authorizes local model inference.
ENABLE_LOCAL_MODELS=0
# COMPRESSION_PYTHON=/absolute/path/to/context-compression/models/.venv/bin/python

# Optional live paired answers, blind judge and multi-step agents.
# No default model is guessed: set a model available to your account.
GEMINI_API_KEY=placeholder
GEMINI_ANSWER_MODEL=
# Defaults to GEMINI_ANSWER_MODEL when omitted.
# GEMINI_JUDGE_MODEL=

# Optional public Laya API on an owner-authorized REMOTE HTTPS service.
# This app never launches a Laya model server on the laptop.
ENABLE_LAYA_REMOTE=0
# LAYA_BASE_URL=https://your-authorized-service.example/
# LAYA_API_KEY=placeholder

# Separate reference-library environment; keep local inference disabled.
# PERPLEXITY_PYTHON=/absolute/path/to/models/perplexity/.venv/bin/python
