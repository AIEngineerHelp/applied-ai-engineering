# Google Gemini: generation, judging, and embeddings run remotely.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANSWER_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
EXPANSION_MODEL=gemini-2.5-flash
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Optional paid-tier token rates; omit when unknown.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=

# Required on Vercel; generate a random secret of at least 32 bytes.
# SEARCH_SIGNING_SECRET=
