# Google Gemini: generation, judging, and embeddings run remotely.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ANSWER_MODEL=gemini-2.5-flash
JUDGE_MODEL=gemini-2.5-flash
EXPANSION_MODEL=gemini-2.5-flash
EMBEDDING_BACKEND=gemini
EMBEDDING_MODEL=gemini-embedding-001

# Optional paid-tier token rates; omit when unknown.
# INPUT_USD_PER_MILLION=
# OUTPUT_USD_PER_MILLION=

# Optional reranking. Gemini uses GEMINI_API_KEY; TypeSafe Jev needs its own key.
TYPESAFE_API_KEY=
RERANK_JEV_MODEL=jev-1.13.0
# RERANK_GEMINI_MODEL=gemini-2.5-flash
# Candidates graded per search, and parallel Jev requests (TypeSafe allows 40 per second).
RERANK_DEPTH=30
RERANK_WORKERS=8
# Jev charges input tokens only; docs.typesafe.ai/models listed 0.042 on 2026-10-02.
# TYPESAFE_INPUT_USD_PER_MILLION=

# Required on Vercel; generate a random secret of at least 32 bytes.
# SEARCH_SIGNING_SECRET=
