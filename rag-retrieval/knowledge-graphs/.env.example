# Copy to .env (Git-ignored). Viewing the page and replaying the recorded results needs none of this.

# Gemini: used by `npm run pipeline -- <step> --live` (paid) and by "Ask your own question".
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Neo4j: local Docker (docker compose up -d, bolt://127.0.0.1:7687) or Neo4j AuraDB
# (neo4j+s://<instance-id>.databases.neo4j.io). Switching is only these three values.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=choose-a-long-random-password

# "Ask your own question" limits. Counts are kept in Neo4j as :AskLog nodes, so they hold
# across server instances; the client's address is stored only as a salted hash.
RATE_LIMIT_SALT=a-long-random-string
ASK_LIMIT_IP_PER_HOUR=5
ASK_LIMIT_PER_DAY=300
# Optional: Neo4j query timeout, the whole request's deadline, and each Gemini call's timeout.
ASK_QUERY_TIMEOUT_MS=5000
ASK_DEADLINE_MS=25000
GEMINI_TIMEOUT_MS=20000
