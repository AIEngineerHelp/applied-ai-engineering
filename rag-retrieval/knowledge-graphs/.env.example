# Copy to .env (Git-ignored). Replaying the recorded results needs none of this.

# Gemini: used by `npm run pipeline -- --live` (paid) and by the local "Ask your own question" panel.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Neo4j: local Docker (docker compose up -d) or Neo4j AuraDB. Switching to Aura is only these three values.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Limits for the "Ask your own question" endpoint.
ASK_RATE_LIMIT_PER_HOUR=20
ASK_QUERY_TIMEOUT_MS=5000
